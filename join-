#!/bin/bash

# Script to join a Kubernetes worker node to a cluster on Amazon Linux
# Resolves tc warning, privilege errors, and handles common join issues
# Usage: ./join-kubernetes-worker.sh

LOG_FILE="/tmp/k8s-join.log"
JOIN_COMMAND="kubeadm join 172.31.10.203:6443 --token yx7u7z.ghcll4kt1hlokkzh --discovery-token-ca-cert-hash sha256:e9aafb8970858dccb2d305219a55801086736053f3d1e7b81f3cdd6d7448c56d"

echo "Starting Kubernetes worker node join process at $(date)" | tee -a $LOG_FILE

# Step 1: Check if running as root or with sudo
if [ "$(id -u)" -ne 0 ]; then
  echo "Error: This script must be run with sudo or as root." | tee -a $LOG_FILE
  exit 1
fi

# Step 2: Install iproute-tc to resolve tc warning
echo "Installing iproute-tc package..." | tee -a $LOG_FILE
yum install -y iproute-tc >> $LOG_FILE 2>&1
if ! command -v tc &> /dev/null; then
  echo "Error: Failed to install tc. Check $LOG_FILE for details." | tee -a $LOG_FILE
  exit 1
fi
echo "tc installed successfully: $(tc -V)" | tee -a $LOG_FILE

# Step 3: Verify prerequisites
echo "Verifying prerequisites..." | tee -a $LOG_FILE
yum install -y docker kubelet-1.28.2 kubeadm-1.28.2 >> $LOG_FILE 2>&1
systemctl enable --now docker kubelet >> $LOG_FILE 2>&1

# Disable swap
swapoff -a
sed -i '/ swap / s/^\(.*\)$/#\1/g' /etc/fstab

# Configure kernel parameters
cat <<EOF | tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-ip6tables = 1
net.bridge.bridge-nf-call-iptables = 1
net.ipv4.ip_forward = 1
EOF
sysctl --system >> $LOG_FILE 2>&1

# Step 4: Test connectivity to master node
echo "Testing connectivity to master node (172.31.10.203:6443)..." | tee -a $LOG_FILE
nc -v 172.31.10.203 6443 >> $LOG_FILE 2>&1
if [ $? -ne 0 ]; then
  echo "Warning: Cannot connect to master node. Checking firewall..." | tee -a $LOG_FILE
  iptables -A INPUT -p tcp --dport 6443 -j ACCEPT >> $LOG_FILE 2>&1
  echo "Please ensure the master's security group allows TCP 6443 and the API server is running." | tee -a $LOG_FILE
fi

# Step 5: Run kubeadm join
echo "Running kubeadm join command..." | tee -a $LOG_FILE
$JOIN_COMMAND --v=5 >> $LOG_FILE 2>&1
if [ $? -eq 0 ]; then
  echo "Worker node successfully joined the cluster!" | tee -a $LOG_FILE
  echo "Verify on the master node with: kubectl get nodes" | tee -a $LOG_FILE
else
  echo "Error: Failed to join cluster. Check $LOG_FILE for details." | tee -a $LOG_FILE
  echo "Troubleshooting steps:" | tee -a $LOG_FILE
  echo "1. On master node, check API server: docker ps | grep kube-apiserver" | tee -a $LOG_FILE
  echo "2. On master, generate new token if expired: kubeadm token create --print-join-command" | tee -a $LOG_FILE
  echo "3. Ensure security group allows TCP 6443 and network ACLs permit traffic." | tee -a $LOG_FILE
  echo "4. Check worker node logs: journalctl -u kubelet" | tee -a $LOG_FILE
  exit 1
fi

# Step 6: Verify kubelet status
echo "Verifying kubelet status..." | tee -a $LOG_FILE
systemctl status kubelet >> $LOG_FILE 2>&1
if [ $? -ne 0 ]; then
  echo "Warning: Kubelet service is not running properly. Check $LOG_FILE." | tee -a $LOG_FILE
fi

echo "Script completed at $(date). Logs saved to $LOG_FILE." | tee -a $LOG_FILE
